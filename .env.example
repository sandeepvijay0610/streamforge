# ============================================================================
# StreamForge — Environment Reference
# ============================================================================
# Copy to .env and adjust for local overrides. The compose stack has sensible
# defaults baked into docker-compose.yml, so .env is optional for local dev.
# ============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_RAW_TOPIC=transactions.raw.v1
KAFKA_CLEANED_TOPIC=transactions.cleaned.v1
KAFKA_FAILED_TOPIC=transactions.failed.v1
KAFKA_RETRY_TOPIC=transactions.retry.v1

# --- Consumer groups ---
ETL_GROUP_ID=streamforge-etl-v1
DB_CONSUMER_GROUP_ID=streamforge-db-consumer-v1
RETRY_CONSUMER_GROUP_ID=streamforge-retry-consumer-v1

# --- PostgreSQL ---
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge
POSTGRES_DB=streamforge
POSTGRES_DSN=host=postgres port=5432 dbname=streamforge user=streamforge password=streamforge

# --- Fraud detector ---
FRAUD_SCAN_INTERVAL_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO