{
  "info": {
    "name": "StreamForge V1",
    "description": "Webhook load tests for StreamForge local ingestion API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "provider-b",
      "item": [
        {
          "name": "payment.succeeded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_pm_{{$guid}}\",\n  \"event_type\": \"payment.succeeded\",\n  \"payload\": {\n    \"transaction_id\": \"txn_pm_{{$guid}}\",\n    \"user_id\": \"usr_{{$randomInt}}\",\n    \"amount\": {{$randomInt}},\n    \"currency\": \"INR\",\n    \"merchant\": \"AMAZON\",\n    \"payment_method\": \"UPI\",\n    \"country_code\": \"IN\",\n    \"status\": \"SUCCESS\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/webhooks/provider-b"
          }
        },
        {
          "name": "payment.failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_pm_{{$guid}}\",\n  \"event_type\": \"payment.failed\",\n  \"payload\": {\n    \"transaction_id\": \"txn_pm_{{$guid}}\",\n    \"user_id\": \"usr_{{$randomInt}}\",\n    \"amount\": {{$randomInt}},\n    \"currency\": \"INR\",\n    \"merchant\": \"SWIGGY\",\n    \"payment_method\": \"CARD\",\n    \"country_code\": \"IN\",\n    \"status\": \"FAILED\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/webhooks/provider-b"
          }
        },
        {
          "name": "bad-amount (negative test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_pm_bad_{{$guid}}\",\n  \"event_type\": \"payment.succeeded\",\n  \"payload\": {\n    \"transaction_id\": \"txn_bad_{{$guid}}\",\n    \"user_id\": \"usr_{{$randomInt}}\",\n    \"amount\": \"seven hundred\",\n    \"currency\": \"INR\",\n    \"country_code\": \"IN\",\n    \"status\": \"SUCCESS\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/webhooks/provider-b"
          }
        }
      ]
    },
    {
      "name": "provider-a",
      "item": [
        {
          "name": "payment.succeeded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_pm_{{$guid}}\",\n  \"event_type\": \"payment.succeeded\",\n  \"payload\": {\n    \"id\": \"txn_pm_{{$guid}}\",\n    \"customer\": \"usr_{{$randomInt}}\",\n    \"value\": \"{{$randomInt}}.50\",\n    \"currency_code\": \"inr\",\n    \"merchant_name\": \"amazon_india\",\n    \"method\": \"gpay\",\n    \"country\": \"India\",\n    \"result\": \"success\",\n    \"created\": \"{{$isoTimestamp}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/webhooks/provider-a"
          }
        }
      ]
    }
  ]
}